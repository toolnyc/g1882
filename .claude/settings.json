{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-tool-gate.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-tool-payload.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/post-tool-tsx-design.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/post-tool-observability.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop.mjs"
          }
        ]
      }
    ]
  }
}
